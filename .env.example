# Environment
# ----

# The .env file holds real values and is gitignored. Only .env.example is committed,
# and it contains variable NAMES only — no values, no secrets, no placeholders that
# look like real values (FR-031, Constitution VII).
#
# QUOTE EVERY VALUE. This file is sourced by a shell (`make run-api` loads it with
# `set -a; . .env`), so an unquoted value containing a space is split into words and
# the rest is run as a command. The repository path contains spaces, so the TLS paths
# in particular must be quoted:
#
#   PMS_TLS_CERT_PATH='/Users/you/Projects/Property management system website/infra/certs/localhost.crt'

# Database connection strings
# ---------------------------

# PMS_DATABASE_OWNER_URL — used by migrations and the offline admintool only. Never
# present in the running service's environment.
PMS_DATABASE_OWNER_URL=

# PMS_DATABASE_APP_URL — the running Go service connects as this role. It holds
# SELECT, INSERT, UPDATE, DELETE on the business tables and only SELECT, INSERT on
# audit_log (Constitution VIII).
PMS_DATABASE_APP_URL=

# Session cookie
# --------------

# PMS_SESSION_COOKIE_NAME — the cookie name. Defaults to pms_session if unset.
PMS_SESSION_COOKIE_NAME=

# TLS material
# ------------

# PMS_TLS_CERT_PATH — PEM-encoded server certificate, including intermediate certs if any.
PMS_TLS_CERT_PATH=

# PMS_TLS_KEY_PATH — PEM-encoded private key for the server certificate.
PMS_TLS_KEY_PATH=

# Listen address
# --------------

# PMS_LISTEN_ADDR — host:port for the TLS listener. Defaults to :8443 if unset.
# TLS is required; the server refuses to start if either cert or key is missing.
PMS_LISTEN_ADDR=

# Production web bundle (optional)
# --------------------------------

# PMS_WEB_DIST — optional absolute path to the Angular production output directory.
# When empty, the Go server remains API-only. The setup scripts fill this so one
# process serves both the API and the browser application.
PMS_WEB_DIST=

# Attachment storage (feature 003-property-attachments-ocr, Constitution VII)
# -------------------------------------------------------------------------

# PMS_ATTACHMENT_STORE — absolute path of a directory outside the repository working
# tree. Encrypted file bodies live here, named by opaque UUID with no extension.
# The directory MUST exist, be writable by the running user, and MUST NOT sit inside
# the repo. Repository-root development store conventions are gitignored as a
# second line of defence, but a deployed store must remain outside the checkout.
PMS_ATTACHMENT_STORE=

# PMS_ATTACHMENT_MAX_BYTES — maximum accepted upload size, in bytes. FR-005 default
# is 52428800 (50 MB). The refusal message states the configured value.
PMS_ATTACHMENT_MAX_BYTES=52428800

# PMS_EXTRACT_TEXT_MAX_BYTES — maximum stored extracted text per attachment, in bytes.
# FR-021 default is 262144 (256 KB). Truncation cuts at a whole-character boundary
# and the row is marked truncated so a phrase past the cut is explicable.
PMS_EXTRACT_TEXT_MAX_BYTES=262144

# Encryption master key (feature 002-properties-crud, Constitution VII)
# ---------------------------------------------------------------------

# PMS_KEK — base64 of 32 random bytes. The server refuses to start without it.
# Generate with: openssl rand -base64 32
# Loss makes every encrypted attachment and sensitive custom field permanently unreadable.
# No value is committed; place the real value in .env only.
PMS_KEK=

# One-command setup
# -----------------

# PMS_ADMIN_PASSWORD — used only by scripts/setup.sh and scripts/setup.ps1 to
# create or reset the administrator without exposing its password in process
# arguments or logs. The running API does not need this variable.
PMS_ADMIN_PASSWORD=

# Local dev convenience: the password `make reset-admin-dev` sets on the admin account.
# Set a value in your own .env (gitignored). Never commit a real value here.
DEV_ADMIN_PASSWORD=
